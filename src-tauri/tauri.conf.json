{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Ghostty Config",
    "version": "0.3.0",
    "identifier": "com.zerebos.ghostty-config",
    "build": {
        "beforeDevCommand": "bun run dev --port 5173 --host",
        "beforeBuildCommand": "bun run build",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Ghostty Config",
                "width": 1280,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "hiddenTitle": true,
                "titleBarStyle": "Transparent"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
